<UserControl x:Class="LocalShare.Desktop.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LocalShare.Desktop.Views"
             xmlns:vm="clr-namespace:LocalShare.Desktop.ViewModels"
             xmlns:myConverter="clr-namespace:LocalShare.Desktop.LocalConverters"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:design="clr-namespace:LocalShare.Desktop.DesignData"
             d:DataContext="{d:DesignInstance Type=vm:SendViewModel,IsDesignTimeCreatable=True}"
             xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="800" d:DesignWidth="1300">
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <UserControl.Resources>
        <myConverter:SendFileProgressConverter x:Key="SendFileProgressConverter"/>
        <myConverter:FileTaskStateConverter x:Key="FileTaskStateConverter"/>
    </UserControl.Resources>
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="文件列表" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Width="88" Height="32" Command="{Binding OpenFilesCommand}">打开文件</Button>
                        <Rectangle Width="10"/>
                        <Button Width="88" Height="32" Command="{Binding OpenDirFilesCommand}">打开文件夹</Button>
                        <Rectangle Width="10"/>
                        <Button Width="88" Height="32" Command="{Binding RemoveSelectedFileCommand}">移除选中</Button>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding HomeDataHolder.FileCaches}" d:DataContext="{d:DesignInstance Type=design:LocalFileCacheDesignData,IsDesignTimeCreatable=True}" d:ItemsSource="{Binding FileCaches}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Width="70">
                                    <GridViewColumn.Header>
                                        <CheckBox Content="全选"
                                                  IsChecked="{Binding IsSelectAll}"
                                                  Command="{Binding GlobalCheckedChangedCommand}"
                                                  CommandParameter="{Binding IsChecked,RelativeSource={RelativeSource Mode=Self}}"></CheckBox>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                          CommandParameter="{Binding IsSelected}"
                                                          Command="{Binding DataContext.EachCheckedChangedCommand,
                                                          RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件名" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}"
                                                       Cursor="Hand"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       ToolTipService.InitialShowDelay="500"
                                                       ToolTipService.ShowDuration="5000"
                                                       ToolTip="{Binding FileName}">
                                                <behavior:Interaction.Triggers>
                                                     <behavior:EventTrigger EventName="MouseLeftButtonDown">
                                                         <behavior:InvokeCommandAction Command="{Binding DataContext.OpenDirectoryCommand,
                                                                                       RelativeSource={RelativeSource Mode=FindAncestor,
                                                                                       AncestorType={x:Type UserControl}}}"
                                                                                       CommandParameter="{Binding FilePath}"/>
                                                     </behavior:EventTrigger>
                                                </behavior:Interaction.Triggers>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件大小" Width="120" DisplayMemberBinding="{Binding FileSize,Converter={StaticResource Long2FileSizeConverter}}"/>
                                <!--<GridViewColumn Header="md5" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Md5}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       ToolTipService.InitialShowDelay="500"
                                                       ToolTipService.ShowDuration="5000"
                                                       ToolTip="{Binding Md5}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>-->
                                <!--<GridViewColumn Header="操作" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenDirectoryCommand,
                                                    RelativeSource={RelativeSource Mode=FindAncestor,
                                                    AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding FilePath}">
                                                打开路径
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>-->
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>


            <GridSplitter Grid.Column="1" Width="4" ShowsPreview="True" HorizontalAlignment="Left"/>
            <GroupBox Grid.Column="1" Header="节点列表" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Width="88" Height="32" Command="{Binding RemoveSelectedNodeCommand}">移除选中</Button>
                    </StackPanel>

                    <ListView x:Name="ListNodes" Grid.Row="1" SelectedIndex="{Binding SelectedNodeIndex}" ItemsSource="{Binding HomeDataHolder.Nodes}" d:ItemsSource="{Binding Nodes}" d:DataContext="{d:DesignInstance Type=design:LocalNodeDesignData,IsDesignTimeCreatable=True}">
                        <behavior:Interaction.Triggers>
                            <behavior:EventTrigger EventName="SelectionChanged">
                                <behavior:InvokeCommandAction Command="{Binding NodeSelectionChangedCommand}"
                                                              CommandParameter="{Binding SelectedItem,RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </behavior:EventTrigger>
                        </behavior:Interaction.Triggers>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Width="70">
                                    <GridViewColumn.Header>
                                        <CheckBox Content="全选"
                                                  IsChecked="{Binding IsNodeSelectAll}"
                                                  Command="{Binding GlobalNodeCheckedChangedCommand}"
                                                  CommandParameter="{Binding IsChecked,RelativeSource={RelativeSource Mode=Self}}"></CheckBox>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      CommandParameter="{Binding IsSelected}"
                                                      Command="{Binding DataContext.EachNodeCheckedChangedCommand,
                                                      RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="节点名称" Width="180" >
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NodeName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       ToolTipService.InitialShowDelay="500"
                                                       ToolTipService.ShowDuration="5000"
                                                       ToolTip="{Binding NodeName}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Column="1" Width="4" ShowsPreview="True" HorizontalAlignment="Right"/>

            <GroupBox Grid.Column="2" Header="发送情况" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!--<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button>移除</Button>
                    </StackPanel>-->

                    <ListView Grid.Row="1" ItemsSource="{Binding CurrentNodeFileTasks}" d:DataContext="{d:DesignInstance Type=design:SendFileTaskDesignData,IsDesignTimeCreatable=True}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Header="文件名" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding FileName}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件大小" Width="100" DisplayMemberBinding="{Binding TotalSize,Converter={StaticResource Long2FileSizeConverter}}"/>
                                <GridViewColumn Header="进度(%)" Width="100" DisplayMemberBinding="{Binding Progress}"/>
                                <GridViewColumn Header="状态" Width="100" DisplayMemberBinding="{Binding State,Converter={StaticResource FileTaskStateConverter}}"/>
                                <GridViewColumn Header="操作" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <!--<Button>暂停</Button>
                                                <Rectangle Width="10"/>-->
                                                <Button Command="{Binding Parent.RemoveFileTaskCommand}"
                                                        CommandParameter="{Binding FileName}">移除</Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>

        </Grid>


        <Border Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Height="30" Width="120" Command="{Binding SendFileCommand}">开始发送</Button>
                <Rectangle Width="10"/>
                <Button Height="30" Width="120">暂停发送</Button>
                <Rectangle Width="10"/>
                <Button Height="30" Width='120'>终止发送</Button>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
