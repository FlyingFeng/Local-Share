<UserControl x:Class="LocalShare.Desktop.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LocalShare.Desktop.Views"
             xmlns:vm="clr-namespace:LocalShare.Desktop.ViewModels"
             xmlns:myConverter="clr-namespace:LocalShare.Desktop.LocalConverters"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:design="clr-namespace:LocalShare.Desktop.DesignData"
             d:DataContext="{d:DesignInstance Type=vm:SendViewModel,IsDesignTimeCreatable=True}"
             xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
             Background="#eeeeee"
             mc:Ignorable="d" 
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="800" d:DesignWidth="1300">
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <UserControl.Resources>
        <myConverter:FileTaskStateToColorConverter x:Key="FileTaskStateToColorConverter"/>
        <myConverter:NodeStateToColorConverter x:Key="NodeStateToColorConverter"/>
        <myConverter:SendFileProgressConverter x:Key="SendFileProgressConverter"/>
        <myConverter:FileTaskStateConverter x:Key="FileTaskStateConverter"/>
        <myConverter:NodeStateConverter x:Key="NodeStateConverter"/>
        <myConverter:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="共享文件列表" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ButtonPrimary}" Width="98" Height="32" Command="{Binding OpenFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <!--<iconPacks:PackIconFontAwesome Kind="FileCirclePlusSolid" />-->
                                <Path Stretch="Uniform" Fill="White" Data="M0 64C0 28.7 28.7 0 64 0H224V128c0 17.7 14.3 32 32 32H384v38.6C310.1 219.5 256 287.4 256 368c0 59.1 29.1 111.3 73.7 143.3c-3.2 .5-6.4 .7-9.7 .7H64c-35.3 0-64-28.7-64-64V64zm384 64H256V0L384 128zm48 96a144 144 0 1 1 0 288 144 144 0 1 1 0-288zm16 80c0-8.8-7.2-16-16-16s-16 7.2-16 16v48H368c-8.8 0-16 7.2-16 16s7.2 16 16 16h48v48c0 8.8 7.2 16 16 16s16-7.2 16-16V384h48c8.8 0 16-7.2 16-16s-7.2-16-16-16H448V304z"></Path>
                                <TextBlock Text="打开文件" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="10"/>
                        <Button Style="{StaticResource ButtonPrimary}" Width="108" Height="32" Command="{Binding OpenDirFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <!--<iconPacks:PackIconFontAwesome Kind="FolderPlusSolid" />-->
                                <Path Stretch="Uniform" Fill="White" Data="M512 416c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V96C0 60.7 28.7 32 64 32H192c20.1 0 39.1 9.5 51.2 25.6l19.2 25.6c6 8.1 15.5 12.8 25.6 12.8H448c35.3 0 64 28.7 64 64V416zM232 376c0 13.3 10.7 24 24 24s24-10.7 24-24V312h64c13.3 0 24-10.7 24-24s-10.7-24-24-24H280V200c0-13.3-10.7-24-24-24s-24 10.7-24 24v64H168c-13.3 0-24 10.7-24 24s10.7 24 24 24h64v64z"></Path>
                                <TextBlock Text="打开文件夹" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="10"/>
                        <Button Style="{StaticResource ButtonDanger}" Width="98" Height="32" Command="{Binding RemoveSelectedFileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <!--<iconPacks:PackIconFontAwesome Kind="TrashSolid" />-->
                                <Path Stretch="Uniform" Fill="White" Data="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"></Path>
                                <TextBlock Text="移除选中" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemContainerStyle="{StaticResource ListViewItemStyle}" ItemsSource="{Binding SendDataHolder.FileCaches}" d:DataContext="{d:DesignInstance Type=design:LocalFileCacheDesignData,IsDesignTimeCreatable=True}" d:ItemsSource="{Binding FileCaches}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Width="40">
                                    <GridViewColumn.Header>
                                        <CheckBox IsChecked="{Binding IsSelectAll}"
                                                  Command="{Binding GlobalCheckedChangedCommand}"
                                                  CommandParameter="{Binding IsChecked,RelativeSource={RelativeSource Mode=Self}}"></CheckBox>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                          CommandParameter="{Binding IsSelected}"
                                                          Command="{Binding DataContext.EachCheckedChangedCommand,
                                                          RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件名称" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}"
                                                       Cursor="Hand"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       ToolTipService.InitialShowDelay="500"
                                                       ToolTipService.ShowDuration="5000"
                                                       ToolTip="{Binding FileName}">
                                                <behavior:Interaction.Triggers>
                                                     <behavior:EventTrigger EventName="MouseLeftButtonDown">
                                                         <behavior:InvokeCommandAction Command="{Binding DataContext.OpenDirectoryCommand,
                                                                                       RelativeSource={RelativeSource Mode=FindAncestor,
                                                                                       AncestorType={x:Type UserControl}}}"
                                                                                       CommandParameter="{Binding FilePath}"/>
                                                     </behavior:EventTrigger>
                                                </behavior:Interaction.Triggers>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件大小" Width="80" DisplayMemberBinding="{Binding FileSize,Converter={StaticResource Long2FileSizeConverter}}"/>
                                <GridViewColumn Header="操作" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding ShowDownloadLinkCommand}" Width="68">
                                                <StackPanel Orientation="Horizontal">
                                                    <!--<iconPacks:PackIconFontAwesome Kind="ShareNodesSolid" />-->
                                                    <Path Stretch="Uniform" Fill="Black" Data="M352 224c53 0 96-43 96-96s-43-96-96-96s-96 43-96 96c0 4 .2 8 .7 11.9l-94.1 47C145.4 170.2 121.9 160 96 160c-53 0-96 43-96 96s43 96 96 96c25.9 0 49.4-10.2 66.6-26.9l94.1 47c-.5 3.9-.7 7.8-.7 11.9c0 53 43 96 96 96s96-43 96-96s-43-96-96-96c-25.9 0-49.4 10.2-66.6 26.9l-94.1-47c.5-3.9 .7-7.8 .7-11.9s-.2-8-.7-11.9l94.1-47C302.6 213.8 326.1 224 352 224z"></Path>
                                                    <TextBlock Text="分享" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!--<GridViewColumn Header="md5" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Md5}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       ToolTipService.InitialShowDelay="500"
                                                       ToolTipService.ShowDuration="5000"
                                                       ToolTip="{Binding Md5}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>-->
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>


            <GridSplitter Grid.Column="1" Width="4" ShowsPreview="True" HorizontalAlignment="Left"/>
            <GroupBox Grid.Column="1" Header="节点列表" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ButtonPrimary}" Width="88" Height="32" Command="{Binding AddLocalNodeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <!--<iconPacks:PackIconMaterialDesign Kind="Add" Height="13"/>-->
                                <Path Stretch="Uniform" Fill="White" Data="m 19,13 h -6 v 6 H 11 V 13 H 5 v -2 h 6 V 5 h 2 v 6 h 6 z"></Path>
                                <TextBlock Text="添加节点" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListView x:Name="ListNodes" ItemContainerStyle="{StaticResource ListViewItemStyle}" Grid.Row="1" SelectedIndex="{Binding SelectedNodeIndex}" ItemsSource="{Binding SendDataHolder.Nodes}" d:ItemsSource="{Binding Nodes}" d:DataContext="{d:DesignInstance Type=design:LocalNodeDesignData,IsDesignTimeCreatable=True}">
                        <behavior:Interaction.Triggers>
                            <behavior:EventTrigger EventName="SelectionChanged">
                                <behavior:InvokeCommandAction Command="{Binding NodeSelectionChangedCommand}"
                                                              CommandParameter="{Binding SelectedItem,RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </behavior:EventTrigger>
                        </behavior:Interaction.Triggers>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Width="40">
                                    <GridViewColumn.Header>
                                        <CheckBox IsChecked="{Binding IsNodeSelectAll}"
                                                  Command="{Binding GlobalNodeCheckedChangedCommand}"
                                                  CommandParameter="{Binding IsChecked,RelativeSource={RelativeSource Mode=Self}}"></CheckBox>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      CommandParameter="{Binding IsSelected}"
                                                      Command="{Binding DataContext.EachNodeCheckedChangedCommand,
                                                      RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="节点名称" Width="100" >
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NodeName}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ShowOnDisabled="True"
                                                           ToolTipService.InitialShowDelay="500"
                                                           ToolTipService.ShowDuration="5000"
                                                           ToolTip="{Binding NodeName}"/>
                                                <Rectangle Height="3"/>
                                                <TextBlock Text="{Binding IpAddress}" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="状态" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding State,Converter={StaticResource NodeStateConverter}}"
                                                       Foreground="{Binding State,Converter={StaticResource NodeStateToColorConverter}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="操作" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <hc:Badge Status="Processing" Background="Red" ShowBadge="{Binding ShowBadge}">
                                                    <Button Width="68" Command="{Binding ShowChatWindowCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!--<iconPacks:PackIconFontAwesome Kind="CommentDotsSolid" />-->
                                                            <Path Stretch="Uniform" Fill="Black" Data="M256 448c141.4 0 256-93.1 256-208S397.4 32 256 32S0 125.1 0 240c0 45.1 17.7 86.8 47.7 120.9c-1.9 24.5-11.4 46.3-21.4 62.9c-5.5 9.2-11.1 16.6-15.2 21.6c-2.1 2.5-3.7 4.4-4.9 5.7c-.6 .6-1 1.1-1.3 1.4l-.3 .3 0 0 0 0 0 0 0 0c-4.6 4.6-5.9 11.4-3.4 17.4c2.5 6 8.3 9.9 14.8 9.9c28.7 0 57.6-8.9 81.6-19.3c22.9-10 42.4-21.9 54.3-30.6c31.8 11.5 67 17.9 104.1 17.9zM128 208a32 32 0 1 1 0 64 32 32 0 1 1 0-64zm128 0a32 32 0 1 1 0 64 32 32 0 1 1 0-64zm96 32a32 32 0 1 1 64 0 32 32 0 1 1 -64 0z"></Path>
                                                            <TextBlock Text="对话" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </hc:Badge>
                                                <Rectangle Width="10"/>
                                                <Button Width="68" Visibility="{Binding State,Converter={StaticResource IntToVisibilityConverter}}"
                                                        Command="{Binding CheckConnectionCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!--<iconPacks:PackIconMaterial Kind="Radar" />-->
                                                        <Path Stretch="Uniform" Fill="Black" Data="M19.07,4.93L17.66,6.34C19.1,7.79 20,9.79 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12C4,7.92 7.05,4.56 11,4.07V6.09C8.16,6.57 6,9.03 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12C18,10.34 17.33,8.84 16.24,7.76L14.83,9.17C15.55,9.9 16,10.9 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12C8,10.14 9.28,8.59 11,8.14V10.28C10.4,10.63 10,11.26 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12C14,11.26 13.6,10.62 13,10.28V2H12A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,9.24 20.88,6.74 19.07,4.93Z"></Path>
                                                        <TextBlock Text="探测" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Column="1" Width="4" ShowsPreview="True" HorizontalAlignment="Right"/>

            <GroupBox Grid.Column="2" Header="发送情况" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!--<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button>移除</Button>
                    </StackPanel>-->

                    <ListView Grid.Row="1" ItemContainerStyle="{StaticResource ListViewItemStyle}" ItemsSource="{Binding CurrentNodeFileTasks}" d:DataContext="{d:DesignInstance Type=design:SendFileTaskDesignData,IsDesignTimeCreatable=True}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Header="文件名称" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding FileName}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件大小" Width="80" DisplayMemberBinding="{Binding TotalSize,Converter={StaticResource Long2FileSizeConverter}}"/>
                                <GridViewColumn Header="状态" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding State,Converter={StaticResource FileTaskStateConverter}}"
                                                Foreground="{Binding State,Converter={StaticResource FileTaskStateToColorConverter}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="进度(%)" Width="70" DisplayMemberBinding="{Binding Progress}"/>
                                <GridViewColumn Header="操作" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding Parent.CancelFileTaskCommand}"
                                                        Width="68"
                                                        Style="{StaticResource ButtonDanger}"
                                                        CommandParameter="{Binding FileName}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!--<iconPacks:PackIconMaterialDesign Kind="Cancel" />-->
                                                        <Path Stretch="Uniform" Fill="White" Data="M 12,2 C 6.47,2 2,6.47 2,12 2,17.53 6.47,22 12,22 17.53,22 22,17.53 22,12 22,6.47 17.53,2 12,2 Z M 17,15.59 15.59,17 12,13.41 8.41,17 7,15.59 10.59,12 7,8.41 8.41,7 12,10.59 15.59,7 17,8.41 13.41,12 Z"></Path>
                                                        <TextBlock Text="取消" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>

        </Grid>


        <Border Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource ButtonPrimary}" Height="30" Width="100" Command="{Binding SendFileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <!--<iconPacks:PackIconMaterial Kind="SendVariant" />-->
                        <Path Stretch="Uniform" Fill="White" Data="M3 20V14L11 12L3 10V4L22 12Z"></Path>
                        <TextBlock Text="发送" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!--<Rectangle Width="10"/>
                <Button Height="30" Width="120">暂停发送</Button>
                <Rectangle Width="10"/>
                <Button Height="30" Width='120'>终止发送</Button>-->
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
