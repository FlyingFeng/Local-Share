<UserControl x:Class="LocalShare.Desktop.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LocalShare.Desktop.Views"
             xmlns:design="clr-namespace:LocalShare.Desktop.DesignData"
             xmlns:vm="clr-namespace:LocalShare.Desktop.ViewModels"
             xmlns:model="clr-namespace:LocalShare.Desktop.Models.Browsers"
             xmlns:sendModel="clr-namespace:LocalShare.Desktop.Models.Sends"
             xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:localConverter="clr-namespace:LocalShare.Desktop.LocalConverters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BrowserViewModel,IsDesignTimeCreatable=True}"
             Background="#eeeeee"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="450" d:DesignWidth="1200">
    <UserControl.Resources>
        <localConverter:FileTaskStateConverter x:Key="FileTaskStateConverter"/>
        <localConverter:FileTaskStateToColorConverter x:Key="FileTaskStateToColorConverter"/>
        <localConverter:NodeStateToColorConverter x:Key="NodeStateToColorConverter"/>
    </UserControl.Resources>
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="10"/>
                <ComboBox ItemContainerStyle="{StaticResource ComboBoxItemContainerStyle}" Width="200" Height="32" ItemsSource="{Binding SendDataHolder.Nodes}" SelectedIndex="{Binding NowIndex}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="sendModel:LocalNode">
                            <TextBlock Text="{Binding NodeName}" Foreground="{Binding State,Converter={StaticResource NodeStateToColorConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <behavior:Interaction.Triggers>
                        <behavior:EventTrigger EventName="SelectionChanged">
                            <behavior:InvokeCommandAction Command="{Binding NodeSelectionChangedCommand}"/>
                        </behavior:EventTrigger>
                    </behavior:Interaction.Triggers>
                </ComboBox>
                <Rectangle Width="18"/>
                <Button Width="100" Height="32" IsEnabled="{Binding RefreshEnabled}" Style="{StaticResource ButtonPrimary}" Command="{Binding RefreshFileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <!--<iconPacks:PackIconPhosphorIcons Kind="ArrowsCounterClockwiseBold" />-->
                        <Path Stretch="Uniform" Fill="White" Data="M88,108H40A12,12,0,0,1,28,96V48a12,12,0,0,1,24,0V67l7.8-7.8A99.42,99.42,0,0,1,130,29.94h.56a99.38,99.38,0,0,1,69.87,28.47,12,12,0,0,1-16.78,17.16,76,76,0,0,0-106.84.63L69,84H88a12,12,0,0,1,0,24Zm128,40H168a12,12,0,0,0,0,24h19l-7.8,7.8a75.55,75.55,0,0,1-53.32,22.26h-.43a75.49,75.49,0,0,1-53.09-21.63,12,12,0,0,0-16.78,17.16,99.38,99.38,0,0,0,69.87,28.47H126a99.42,99.42,0,0,0,70.16-29.29L204,189v19a12,12,0,0,0,24,0V160A12,12,0,0,0,216,148Z"></Path>
                        <TextBlock Text="刷新" Margin="2,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--<ScrollViewer Grid.Row="1">-->
            <TreeView Grid.Row="1"  ItemsSource="{Binding FileNodes}" d:DataContext="{d:DesignInstance Type=design:BrowserDesignData, IsDesignTimeCreatable=True}" d:ItemsSource="{Binding Nodes}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItemBaseStyle}">
                        <Setter Property="ContextMenu" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="下载"
                                                          Command="{Binding DownloadFileCommand}"
                                                          CommandParameter="{Binding NodeName}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}" DataType="{x:Type model:RemoteNodeItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NodeName}"/>
                            <Rectangle Width="5"/>
                            <TextBlock Text="{Binding FileSize,Converter={StaticResource Long2FileSizeConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockDefaultInfo}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <!--</ScrollViewer>-->


        </Grid>



        <Border Grid.Column="1">
            <ListView ItemsSource="{Binding DownloadDataHolder.DownloadItems}" d:DataContext="{d:DesignInstance Type=design:BrowserDesignData, IsDesignTimeCreatable=True}" d:ItemsSource="{Binding DownloadFileTasks}">
                <ListView.View>
                    <GridView AllowsColumnReorder="True">
                        <GridViewColumn Header="文件名称" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ShowOnDisabled="True"
                                               ToolTipService.InitialShowDelay="500"
                                               ToolTipService.ShowDuration="5000"
                                               ToolTip="{Binding FileName}">
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="节点名称" Width="80" DisplayMemberBinding="{Binding NodeName}"/>
                        <GridViewColumn Header="文件大小" Width="80" DisplayMemberBinding="{Binding TotalSize,Converter={StaticResource Long2FileSizeConverter}}"/>
                        <GridViewColumn Header="状态" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding State,Converter={StaticResource FileTaskStateConverter}}"
                                        Foreground="{Binding State,Converter={StaticResource FileTaskStateToColorConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="进度(%)" Width="70" DisplayMemberBinding="{Binding Progress}"/>
                        <GridViewColumn Header="操作" Width="210">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ButtonDanger}"
                                                Width="63"
                                                Command="{Binding Path=DataContext.CancelDownloadFileTaskCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <!--<iconPacks:PackIconMaterialDesign Kind="Cancel" />-->
