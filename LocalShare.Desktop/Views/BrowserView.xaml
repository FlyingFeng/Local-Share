                                                <TextBlock Text="取消" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Rectangle Width="3"/>
                                        <Button Style="{StaticResource ButtonWarning}"
                                                Width="63"
                                                Command="{Binding Path=DataContext.StopDownloadFileTaskCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <!--<iconPacks:PackIconMaterialDesign Kind="PauseCircleSharp" />-->
                                                <Path Stretch="Uniform" Fill="White" Data="M 12 2 C 6.4800055 2 2 6.4800055 2 12 C 2 17.519994 6.4800055 22 12 22 C 17.519994 22 22 17.519994 22 12 C 22 6.4800055 17.519994 2 12 2 z M 9 8 L 11 8 L 11 16 L 9 16 L 9 8 z M 13 8 L 15 8 L 15 16 L 13 16 L 13 8 z "></Path>
                                                <TextBlock Text="停止" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Rectangle Width="3"/>
                                        <Button Style="{StaticResource ButtonPrimary}"
                                                Width="63"
                                                Command="{Binding Path=DataContext.StartDownloadFileTaskCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <!--<iconPacks:PackIconFontAwesome Kind="CirclePlayRegular" />-->
                                                <Path Stretch="Uniform" Fill="White" Data="M464 256A208 208 0 1 0 48 256a208 208 0 1 0 416 0zM0 256a256 256 0 1 1 512 0A256 256 0 1 1 0 256zM188.3 147.1c7.6-4.2 16.8-4.1 24.3 .5l144 88c7.1 4.4 11.5 12.1 11.5 20.5s-4.4 16.1-11.5 20.5l-144 88c-7.4 4.5-16.7 4.7-24.3 .5s-12.3-12.2-12.3-20.9V168c0-8.7 4.7-16.7 12.3-20.9z"></Path>
                                                <TextBlock Text="开始" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

    </Grid>
</UserControl>
