<UserControl x:Class="LocalShare.Desktop.Views.SendAndReceiveHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LocalShare.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SendAndReceiveHistoryViewModel,IsDesignTimeCreatable=True}"
             xmlns:local="clr-namespace:LocalShare.Desktop.Views"
             mc:Ignorable="d" 
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="1">
            <TabItem Header="发送记录">
                <ListView ItemsSource="{Binding SendHistoryRecords}">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Header="任务Id" Width="100" DisplayMemberBinding="{Binding TaskId}"/>
                            <GridViewColumn Header="任务状态" Width="80" DisplayMemberBinding="{Binding State}"/>
                            <GridViewColumn Header="发送节点" Width="80" DisplayMemberBinding="{Binding SendNodeName}"/>
                            <GridViewColumn Header="接收节点" Width="80" DisplayMemberBinding="{Binding ReceiveNodeName}"/>
                            <GridViewColumn Header="文件名称" Width="100" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="完整路径" Width="150" DisplayMemberBinding="{Binding FileFullName}"/>
                            <GridViewColumn Header="发送节点IP地址" Width="130" DisplayMemberBinding="{Binding SendIpAddress}"/>
                            <GridViewColumn Header="接收节点IP地址" Width="130" DisplayMemberBinding="{Binding ReceiveIpAddress}"/>
                            <GridViewColumn Header="创建时间" Width="130" DisplayMemberBinding="{Binding InitTime}"/>
                            <GridViewColumn Header="完成时间" Width="130" DisplayMemberBinding="{Binding LastUpdateTime}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="接收记录">
                <ListView ItemsSource="{Binding ReceiveHistoryRecords}">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Header="任务Id" Width="100" DisplayMemberBinding="{Binding TaskId}"/>
                            <GridViewColumn Header="任务状态" Width="80" DisplayMemberBinding="{Binding State}"/>
                            <GridViewColumn Header="发送节点" Width="80" DisplayMemberBinding="{Binding SendNodeName}"/>
                            <GridViewColumn Header="接收节点" Width="80" DisplayMemberBinding="{Binding ReceiveNodeName}"/>
                            <GridViewColumn Header="文件名称" Width="100" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="完整路径" Width="150" DisplayMemberBinding="{Binding FileFullName}"/>
                            <GridViewColumn Header="发送节点IP地址" Width="130" DisplayMemberBinding="{Binding SendIpAddress}"/>
                            <GridViewColumn Header="接收节点IP地址" Width="130" DisplayMemberBinding="{Binding ReceiveIpAddress}"/>
                            <GridViewColumn Header="创建时间" Width="130" DisplayMemberBinding="{Binding InitTime}"/>
                            <GridViewColumn Header="完成时间" Width="130" DisplayMemberBinding="{Binding LastUpdateTime}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
