<UserControl x:Class="LocalShare.Desktop.Views.ReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LocalShare.Desktop.Views"
             xmlns:myConverter="clr-namespace:LocalShare.Desktop.LocalConverters"
             xmlns:vm="clr-namespace:LocalShare.Desktop.ViewModels"
             xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:design="clr-namespace:LocalShare.Desktop.DesignData"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#eeeeee"
             d:DataContext="{d:DesignInstance Type=vm:ReceiveViewModel,IsDesignTimeCreatable=True}"
             Unloaded="UserControl_Unloaded"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="960">
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <UserControl.Resources>
        <myConverter:FileTaskStateConverter x:Key="FileTaskStateConverter"/>
        <myConverter:FileTaskStateToColorConverter x:Key="FileTaskStateToColorConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ListView Grid.Row="1" ItemsSource="{Binding CacheData}" ItemContainerStyle="{StaticResource ListViewItemStyle}" d:DataContext="{d:DesignInstance Type=design:ReceiveFileTaskDesignData,IsDesignTimeCreatable=True}">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="任务编号" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TaskId}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTipService.InitialShowDelay="500"
                                           ToolTipService.ShowDuration="5000"
                                           ToolTip="{Binding TaskId}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="文件名称" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTipService.InitialShowDelay="500"
                                           ToolTipService.ShowDuration="5000"
                                           ToolTip="{Binding FileName}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="保存路径" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SaveFilePath}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTipService.InitialShowDelay="500"
                                           ToolTipService.ShowDuration="5000"
                                           ToolTip="{Binding SaveFilePath}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="文件大小" Width="100" DisplayMemberBinding="{Binding TotalSize,Converter={StaticResource Long2FileSizeConverter}}"/>
                    <GridViewColumn Header="发送节点名称" Width="100" DisplayMemberBinding="{Binding SendNodeName}"/>
                    <GridViewColumn Header="进度(%)" Width="80" DisplayMemberBinding="{Binding Progress}"/>
                    <GridViewColumn Header="状态" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding State,Converter={StaticResource FileTaskStateConverter}}"
                                    Foreground="{Binding State,Converter={StaticResource FileTaskStateToColorConverter}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="操作" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding Path=DataContext.RemoveFileTaskCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                            CommandParameter="{Binding TaskId}"
                                            Style="{StaticResource ButtonDanger}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="TrashSolid" />
                                            <TextBlock Text="移除" Margin="2,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
