<UserControl x:Class="LocalShare.Desktop.Views.ReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LocalShare.Desktop.Views"
             xmlns:vm="clr-namespace:LocalShare.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ReceiveViewModel,IsDesignTimeCreatable=True}"
             Unloaded="UserControl_Unloaded"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ListView Grid.Row="1" ItemsSource="{Binding CacheData}">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="文件名称" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTipService.InitialShowDelay="500"
                                           ToolTipService.ShowDuration="5000"
                                           ToolTip="{Binding FileName}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="文件大小" Width="120" DisplayMemberBinding="{Binding TotalSize,Converter={StaticResource Long2FileSizeConverter}}"/>
                    <GridViewColumn Header="发送节点名称" Width="120" DisplayMemberBinding="{Binding SendNodeName}"/>
                    <GridViewColumn Header="任务编号" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TaskId}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTipService.InitialShowDelay="500"
                                           ToolTipService.ShowDuration="5000"
                                           ToolTip="{Binding TaskId}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="保存路径" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SaveFilePath}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTipService.InitialShowDelay="500"
                                           ToolTipService.ShowDuration="5000"
                                           ToolTip="{Binding SaveFilePath}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="进度" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Style="{StaticResource ProgressBarInfo}" Maximum="100" Value="{Binding Progress}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
