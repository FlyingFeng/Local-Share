<Window x:Class="LocalShare.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalShare.Desktop"
        xmlns:vm="clr-namespace:LocalShare.Desktop.ViewModels"
        xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Closing="Window_Closing"
        WindowState="Maximized"
        ShowInTaskbar="True"
        Icon="{StaticResource AppIcon}"
        Title="Local Share" Height="900" Width="1200">
    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    <d:Window.DataContext>
        <vm:MainViewModel/>
    </d:Window.DataContext>
    <Grid Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Margin="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray"/>
                <StackPanel Orientation="Vertical">
                    <Rectangle Height="8"/>
                    <TextBlock Text="IP地址" HorizontalAlignment="Center"/>
                    <Rectangle Height="4"/>
                    <TextBox Text="{Binding IpAddress}" Height="32" IsReadOnly="True" Margin="1" VerticalContentAlignment="Center"/>
                    <Rectangle Height="4"/>
                    <TextBlock Text="当前节点" HorizontalAlignment="Center"/>
                    <Rectangle Height="4"/>
                    <TextBox Text="{Binding NodeName}" Height="32" VerticalContentAlignment="Center" Margin="1"/>
                    <Rectangle Height="4"/>
                    <Button Width="147" Height="32" Style="{StaticResource ButtonPrimary}" Command="{Binding RandomNodeNameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconFeatherIcons Kind="Box" />
                            <TextBlock Text="随机名称" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Height="4"/>
                    <Button Width="147" Height="32" Style="{StaticResource ButtonPrimary}" Command="{Binding UpdateNodeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" />
                            <TextBlock Text="保存" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Rectangle Height="50"/>
                    <Button Background="{Binding SendBrush}" Width="147" Height="32" Command="{Binding SendViewActionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="SendVariant" />
                            <TextBlock Text="发送" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Height="10"/>
                    <Button Background="{Binding ReceiveBrush}" Width="147" Height="32" Command="{Binding ReceiveViewActionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconRemixIcon Kind="FolderReceivedLine" />
                            <TextBlock Text="接收" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Height="10"/>
                    <Button Background="{Binding BrowserBrush}" Width="147" Height="32" Command="{Binding BrowserViewActionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconFeatherIcons Kind="Globe" />
                            <TextBlock Text="浏览" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Height="10"/>
                    <Button Background="{Binding HistoryBrush}" Width="147" Height="32" Command="{Binding HistoryViewActionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconPhosphorIcons Kind="ClockCounterClockwise" />
                            <TextBlock Text="记录" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Height="10"/>
                    <Button Background="{Binding SettingBrush}" Width="147" Height="32" Command="{Binding SettingViewActionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconFeatherIcons Kind="Settings" />
                            <TextBlock Text="设置" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Height="10"/>
                    <Button Background="{Binding AboutBrush}" Width="147" Height="32" Command="{Binding AboutViewActionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="InformationVariant" />
                            <TextBlock Text="关于" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Margin="1" Grid.Column="1">
            <Grid>
                <ContentControl Content="{Binding MainContent}"></ContentControl>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Right">
                    <StackPanel hc:Growl.GrowlParent="True" VerticalAlignment="Top">

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Visibility="{Binding MaskVisibility}" Background="Transparent" Grid.ColumnSpan="2" CornerRadius="5" BorderBrush="Orange" BorderThickness="4">
            <hc:LoadingCircle  Visibility="{Binding MaskVisibility}" d:Visibility="Visible"/>
        </Border>
    </Grid>
</Window>
