<Application x:Class="LocalShare.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             
             xmlns:local="clr-namespace:LocalShare.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="/Res/app-16x16.ico"
                        ToolTipText="Local Share"
                        Visibility="Visible"/>

            <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Res/app.ico" />
            <BitmapImage x:Key="AppIcon16" UriSource="pack://application:,,,/Res/app-16x16.ico" />
            <BitmapImage x:Key="AppIcon32" UriSource="pack://application:,,,/Res/app-32x32.ico" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
