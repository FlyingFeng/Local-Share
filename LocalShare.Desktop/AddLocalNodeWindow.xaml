<Window x:Class="LocalShare.Desktop.AddLocalNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalShare.Desktop"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="添加节点" Height="160" Width="600">

    <StackPanel Orientation="Vertical">
        <Rectangle Height="20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <hc:TextBox x:Name="TxtIpAddress" hc:InfoElement.Placeholder="IP地址" Width="230" Margin="5"/>
            <TextBlock Text=":" VerticalAlignment="Center"/>
            <hc:TextBox x:Name="TxtPort" hc:InfoElement.Placeholder="端口" Width="100" Margin="5"/>
        </StackPanel>
        <Rectangle Height="20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnAddNode" Click="BtnAddNode_Click" Width="100" Height="30" Style="{StaticResource ButtonPrimary}">
                <StackPanel Orientation="Horizontal">
                    <!--<iconPacks:PackIconMaterialDesign Kind="Add" Height="13"/>-->
                    <Path Stretch="Uniform" Fill="White" Data="m 19,13 h -6 v 6 H 11 V 13 H 5 v -2 h 6 V 5 h 2 v 6 h 6 z"></Path>
                    <TextBlock Text="添加" Margin="2,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Rectangle Width="20"/>
            <Button x:Name="BtnCancel" Click="BtnCancel_Click" Width="100" Height="30" Style="{StaticResource ButtonPrimary}">
                <StackPanel Orientation="Horizontal">
                    <!--<iconPacks:PackIconPhosphorIcons Kind="ArrowUDownLeftBold" />-->
                    <Path Stretch="Uniform" Fill="White" Data="M236,112a68.07,68.07,0,0,1-68,68H61l27.52,27.51a12,12,0,0,1-17,17l-48-48a12,12,0,0,1,0-17l48-48a12,12,0,1,1,17,17L61,156H168a44,44,0,0,0,0-88H80a12,12,0,0,1,0-24h88A68.07,68.07,0,0,1,236,112Z"></Path>
                    <TextBlock Text="退出" Margin="2,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
